{
  "name": "habit-tracker",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "build-info": "node scripts/build-info.mjs",
    "s": "npm run build-info && ng serve",
    "start": "npm run build-info && ng serve",
    "build": "npm run build-info && ng build",
    "b": "npm run build-info && ng build --base-href=/habit-tracker/",
    "g": "npm run build-info && ng build --base-href=/g/",
    "watch": "npm run build-info && ng build --watch --configuration development",
    "test": "npm run build-info && ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@tailwindcss/postcss": "^4.1.10",
    "marked": "^18.0.9",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.10",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.17",
    "@angular/cli": "^18",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
