{
  "id": "habit-tracker",
  "name": "Addhuri Habit Tracker",
  "short_name": "Habits",
  "description": "Build better routines with Addhuri Habit Tracker. Check off daily habits and to-dos, track current and longest streaks, and organize habits by category.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./dashboard",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "categories": ["lifestyle", "productivity", "health"],
  "icons": [
    { "src": "android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "addhuri-habit-tracker-logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "ToDos",
      "short_name": "ToDos",
      "description": "Check off today's habits",
      "url": "./todos",
      "icons": [{ "src": "android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Create Habit",
      "short_name": "New habit",
      "description": "Add a new habit to track",
      "url": "./create",
      "icons": [{ "src": "android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
